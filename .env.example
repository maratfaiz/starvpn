# ═══════════════════════════════════════════════════
#  STAR VPN — Environment Variables
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# ═══════════════════════════════════════════════════

# ─── Telegram Bot ───────────────────────────────────
TELEGRAM_API_TOKEN=          # From @BotFather
TELEGRAM_ADMIN_ID=           # Your Telegram numeric ID (via @userinfobot)
BOT_USERNAME=star_vpn_bot    # Bot username without @

# ─── Telegram Mini App ──────────────────────────────
WEBAPP_URL=https://your-domain.com       # HTTPS URL of the webapp (required for Mini App)
WEBAPP_API_URL=https://your-domain.com   # Same or API subdomain

# ─── PostgreSQL ─────────────────────────────────────
POSTGRES_USER=starvpn
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD
POSTGRES_DB=starvpn

# SQLAlchemy async URL (used by both bot and Marzban)
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://starvpn:REPLACE_STRONG_PASSWORD@db:5432/starvpn

# ─── Marzban ────────────────────────────────────────
MARZBAN_URL=http://marzban:8000          # Internal Docker service URL
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=REPLACE_MARZBAN_PASSWORD

# ─── Payments: Robokassa ─────────────────────────────
ROBOKASSA_MERCHANT_ID=
ROBOKASSA_PASSWORD1=         # For generating payment links
ROBOKASSA_PASSWORD2=         # For verifying incoming webhooks

# ─── Payments: Prodamus ──────────────────────────────
PRODAMUS_SECRET_KEY=
PRODAMUS_SHOP_URL=           # e.g. https://yourshop.payform.ru

# ─── Payments: CryptoPay (@CryptoBot) ────────────────
# Получи токен у @CryptoBot → My Apps → Create App
# Webhook URL: https://YOUR_DOMAIN/crypto/webhook
# В @CryptoBot настрой: My Apps → твоё приложение → Webhooks → укажи URL
CRYPTOPAY_TOKEN=             # API токен из @CryptoBot
