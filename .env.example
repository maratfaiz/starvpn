# ═══════════════════════════════════════════════════
#  STAR VPN — Environment Variables
#  Copy to .env and fill in your values.
#  Never commit .env to version control.
# ═══════════════════════════════════════════════════

# ─── Telegram Bot ───────────────────────────────────
TELEGRAM_API_TOKEN=          # From @BotFather
TELEGRAM_ADMIN_ID=           # Your Telegram numeric ID (via @userinfobot)
BOT_USERNAME=star_vpn_bot    # Bot username without @ — подставляется во все ссылки на бота на сайте
SUPPORT_USERNAME=@your_support   # Аккаунт поддержки (кнопка «Поддержка» в боте, ссылки на сайте)

# ─── Telegram Mini App ──────────────────────────────
WEBAPP_URL=https://your-domain.com       # HTTPS URL of the webapp (required for Mini App)

# ─── PostgreSQL ─────────────────────────────────────
POSTGRES_USER=starvpn
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD
POSTGRES_DB=starvpn

# SQLAlchemy async URL (used by both bot and Marzban)
SQLALCHEMY_DATABASE_URL=postgresql+asyncpg://starvpn:REPLACE_STRONG_PASSWORD@db:5432/starvpn

# ─── Marzban ────────────────────────────────────────
MARZBAN_URL=http://marzban:8000          # Internal Docker service URL
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=REPLACE_MARZBAN_PASSWORD

# ─── Payments: Robokassa ─────────────────────────────
ROBOKASSA_MERCHANT_ID=
ROBOKASSA_PASSWORD1=         # For generating payment links
ROBOKASSA_PASSWORD2=         # For verifying incoming webhooks
ROBOKASSA_TEST_MODE=false    # Set true while testing in Robokassa's test shop

# ─── Payments: CryptoPay (@CryptoBot) ────────────────
# Получи токен у @CryptoBot → My Apps → Create App
# Webhook URL: https://YOUR_DOMAIN/crypto/webhook
# В @CryptoBot настрой: My Apps → твоё приложение → Webhooks → укажи URL
CRYPTOPAY_TOKEN=             # API токен из @CryptoBot

# ─── Личный кабинет: вход по email + паролю ──────
SITE_URL=https://your-domain.com    # Публичный URL сайта
SMTP_HOST=                          # Пусто = код подтверждения только пишется в лог бота (для теста без почты)
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=STAR VPN <noreply@your-domain.com>

# ─── Личный кабинет: вход через Telegram (OIDC) ──────
# BotFather → твой бот → Bot Settings → Login Widget: получаешь Client ID (числовой
# ID бота — часть токена до двоеточия) и Client Secret; там же в Redirect URIs
# добавляешь {SITE_URL}/api/telegram-oauth/callback, а в Trusted Origins — {SITE_URL}.
# Точные адреса и последняя ошибка входа видны в /admin → Настройки.
# Подробнее: https://core.telegram.org/bots/telegram-login
TELEGRAM_OAUTH_CLIENT_ID=
TELEGRAM_OAUTH_CLIENT_SECRET=

# ─── Админ-панель (/admin) ───────────────────────────
# Мастер-ключ: нужен, чтобы зарегистрировать ПЕРВЫЙ аккаунт админки
# (вкладка «Первый вход»). Дальше сотрудники входят по логину/паролю,
# новых приглашают по личному ключу из раздела «Профиль».
# Сгенерировать: openssl rand -hex 24
ADMIN_WEB_KEY=

# ─── VPN-сервер (показывается пользователю в Mini App и кабинете) ───
SERVER_HOST=vpn.your-domain.com
SERVER_COUNTRY=Нидерланды
SERVER_CITY=Амстердам
SERVER_FLAG=🇳🇱
SERVER_PORT=443
SERVER_SNI=www.google.com

# ─── Бизнес-настройки ────────────────────────────────
TRIAL_DAYS=2                 # Длина пробного периода, дней

# Старые ссылки подписки без подписи (/sub/<имя>) выключены: по ним можно было
# получить чужой ключ. true — временно разрешить, пока пользователи не
# перевыпустят ссылки (новые ссылки подписаны автоматически).
SUB_ALLOW_UNSIGNED=false
